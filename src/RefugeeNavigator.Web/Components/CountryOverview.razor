@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResource> Localizer

<main id="main-content" class="country-page">
    <div class="page-content">
        <a class="back-link" href="/"><span aria-hidden="true">←</span> @Localizer["Country.BackToCountries"]</a>

        <header class="country-header">
            <p class="eyebrow">@Localizer["Country.Overview"]</p>
            <h1>@CountryDisplayName</h1>
            <p class="subtitle">@Localizer["Country.HeaderSubtitle", CountryDisplayName]</p>
        </header>

        <section class="introduction" aria-labelledby="living-heading">
            <h2 id="living-heading">@Localizer["Country.LivingIn", CountryDisplayName]</h2>
            <p>@Localizer["Country.LivingDescription", CountryDisplayName]</p>
        </section>

        <section class="categories" aria-labelledby="categories-heading">
            <div class="section-heading">
                <p class="eyebrow">@Localizer["Country.ExploreTopics"]</p>
                <h2 id="categories-heading">@Localizer["Country.InformationCategories"]</h2>
            </div>

            <div class="category-grid">
                <article class="category-card">
                    <h3>@Localizer["Category.TemporaryProtection"]</h3>
                    <p>@Localizer["Category.TemporaryProtectionDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/temporary-protection">@Localizer["Country.ExploreCategory", Localizer["Category.TemporaryProtection"].Value] <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>@Localizer["Category.Employment"]</h3>
                    <p>@Localizer["Category.EmploymentDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/employment">@Localizer["Country.ExploreCategory", Localizer["Category.Employment"].Value] <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>@Localizer["Category.Healthcare"]</h3>
                    <p>@Localizer["Category.HealthcareDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/healthcare">@Localizer["Country.ExploreCategory", Localizer["Category.Healthcare"].Value] <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>@Localizer["Category.Housing"]</h3>
                    <p>@Localizer["Category.HousingDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/housing">@Localizer["Country.ExploreCategory", Localizer["Category.Housing"].Value] <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>@Localizer["Category.Education"]</h3>
                    <p>@Localizer["Category.EducationDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/education">@Localizer["Country.ExploreCategory", Localizer["Category.Education"].Value] <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>@Localizer["Category.SocialAssistance"]</h3>
                    <p>@Localizer["Category.SocialAssistanceDescription"]</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/social-assistance">@Localizer["Country.ExploreCategory", Localizer["Category.SocialAssistance"].Value] <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </section>

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>

@code {
    [Parameter]
    public required string CountryName { get; set; }

    private string CountrySlug => CountryName switch
    {
        "Denmark" => "denmark",
        "Germany" => "germany",
        "Poland" => "poland",
        _ => string.Empty
    };

    private string CountryDisplayName => CountryName switch
    {
        "Denmark" => Localizer["Country.Denmark"].Value,
        "Germany" => Localizer["Country.Germany"].Value,
        "Poland" => Localizer["Country.Poland"].Value,
        _ => CountryName
    };
}
