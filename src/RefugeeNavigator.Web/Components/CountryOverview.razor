@using Microsoft.AspNetCore.Components

<main id="main-content" class="country-page">
    <div class="page-content">
        <a class="back-link" href="/">← Back to countries</a>

        <header class="country-header">
            <p class="eyebrow">Country overview</p>
            <h1>@CountryName</h1>
            <p class="subtitle">Practical information for Ukrainians under temporary protection in @CountryName.</p>
        </header>

        <section class="introduction" aria-labelledby="living-heading">
            <h2 id="living-heading">Living in @CountryName</h2>
            <p>Explore essential topics related to living in @CountryName under temporary protection.</p>
        </section>

        <section class="categories" aria-labelledby="categories-heading">
            <div class="section-heading">
                <p class="eyebrow">Explore essential topics</p>
                <h2 id="categories-heading">Information categories</h2>
            </div>

            <div class="category-grid">
                <article class="category-card">
                    <h3>Temporary protection</h3>
                    <p>Residence status and administrative procedures.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/temporary-protection">Explore temporary protection <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>Employment</h3>
                    <p>Finding work and understanding employment requirements.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/employment">Explore employment <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>Healthcare</h3>
                    <p>Accessing healthcare services.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/healthcare">Explore healthcare <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>Housing</h3>
                    <p>Finding accommodation and understanding housing options.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/housing">Explore housing <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>Education</h3>
                    <p>Education and learning opportunities.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/education">Explore education <span aria-hidden="true">→</span></a>
                </article>

                <article class="category-card">
                    <h3>Social assistance</h3>
                    <p>Available support and assistance programs.</p>
                    <a class="category-link" href="/countries/@CountrySlug/categories/social-assistance">Explore social assistance <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </section>

        <footer class="information-note">
            <p>Information may change. Always confirm important requirements with official authorities.</p>
        </footer>
    </div>
</main>

@code {
    [Parameter]
    public required string CountryName { get; set; }

    private string CountrySlug => CountryName switch
    {
        "Denmark" => "denmark",
        "Germany" => "germany",
        "Poland" => "poland",
        _ => string.Empty
    };
}
