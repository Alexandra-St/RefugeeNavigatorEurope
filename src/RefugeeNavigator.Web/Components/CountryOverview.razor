@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Hosting
@using RefugeeNavigator.Data
@using RefugeeNavigator.Domain
@using RefugeeNavigator.Web.Content
@using RefugeeNavigator.Web.Guides
@page "/countries/{CountrySlug}"
@inject CatalogData Catalog
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer
@inject StepByStepGuideCatalog GuideCatalog
@inject IWebHostEnvironment HostEnvironment

@if (Country is not null)
{
<PageTitle>@Localizer["Country.PageTitle", CountryDisplayName]</PageTitle>

<HomeLink Placement="top" />

<main id="main-content" class="country-page">
    <div class="page-content">
        <header class="country-header">
            <p class="eyebrow">@Localizer["Country.Overview"]</p>
            <h1>@CountryDisplayName</h1>
            <p class="subtitle">@Localizer["Country.HeaderSubtitle", CountryLocationName]</p>
        </header>

        <section class="introduction" aria-labelledby="living-heading">
            <h2 id="living-heading">@Localizer["Country.LivingIn", CountryLocationName]</h2>
            <p>@Localizer["Country.LivingDescription", CountryLocationName]</p>
        </section>

        @if (Country is { } country && GuideForCountry is { } guide)
        {
            <aside class="country-guide-callout" aria-labelledby="country-guide-heading">
                <div>
                    <h2 id="country-guide-heading">@Localizer["Country.GuideCalloutTitle"]</h2>
                    <p>@Localizer["Country.GuideCalloutDescription"]</p>
                </div>
                <a href="@($"/guides/{country.Slug}/{guide.Slug}")">@Localizer["Country.GuideCalloutLink"]</a>
            </aside>
        }

        <section class="categories" aria-labelledby="categories-heading">
            <div class="section-heading">
                <p class="eyebrow">@Localizer["Country.ExploreTopics"]</p>
                <h2 id="categories-heading">@Localizer["Country.InformationCategories"]</h2>
            </div>

            <div class="category-grid">
                @foreach (var category in Catalog.Categories)
                {
                    var categoryName = Localizer[CatalogLocalizationKeyResolver.CategoryName(category)].Value;
                    var categoryDescription = Localizer[CatalogLocalizationKeyResolver.CategoryDescription(category)].Value;

                    <article class="category-card">
                        <div class="category-card-heading">
                            <CategoryIcon Slug="@category.Slug" />
                            <h3>@categoryName</h3>
                        </div>
                        <p>@categoryDescription</p>
                        <a class="category-link" href="/countries/@CountrySlug/categories/@category.Slug">@Localizer["Country.ExploreCategory", categoryName] <span aria-hidden="true">→</span></a>
                    </article>
                }
            </div>
        </section>

        <HomeLink Placement="bottom" />

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>
}

@code {
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    private Country? Country => CountryVisibility.GetVisibleCountries(Catalog, HostEnvironment.IsDevelopment()).FirstOrDefault(country =>
        string.Equals(country.Slug, CountrySlug, StringComparison.OrdinalIgnoreCase));

    private string CountryDisplayName => Country is { } country
        ? Localizer[CatalogLocalizationKeyResolver.CountryName(country)].Value
        : string.Empty;

    private string CountryLocationName => Country is { } country
        ? Localizer[$"{CatalogLocalizationKeyResolver.CountryName(country)}.In"].Value
        : string.Empty;

    private StepByStepGuide? GuideForCountry => Country is { } country
        ? GuideCatalog.Guides.FirstOrDefault(guide =>
            guide.CountryId == country.Id &&
            StepByStepGuideVisibility.CanRender(guide.EditorialStatus, HostEnvironment.IsDevelopment()))
        : null;

    protected override void OnParametersSet()
    {
        if (Country is null)
        {
            Navigation.NotFound();
        }
    }
}
