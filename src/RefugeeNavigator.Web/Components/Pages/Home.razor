@page "/"
@using RefugeeNavigator.Data
@using Microsoft.AspNetCore.Hosting
@using RefugeeNavigator.Web.Content
@inject CatalogData Catalog
@inject IWebHostEnvironment HostEnvironment
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Home.PageTitle"]</PageTitle>

<main id="main-content" class="landing-page">
    <div class="page-content">
        <header class="hero">
            <h1>@Localizer["Home.Eyebrow"]</h1>
            <p class="hero-subtitle">@Localizer["Home.HeroSubtitle"]</p>
        </header>

        <section class="introduction" aria-labelledby="introduction-heading">
            <h2 id="introduction-heading">@Localizer["Home.FindGuidance"]</h2>
            <p>@Localizer["Home.IntroductionDescription"]</p>
            <p>@Localizer["Home.OfficialSources"]</p>
        </section>

        <div class="feature-cards">
            <div class="feature-grid">
                <article class="feature-card">
                    <h3>@Localizer["Home.SearchTitle"]</h3>
                    <p>@Localizer["Home.SearchDescription"]</p>
                    <a href="/search">@Localizer["Home.OpenSearch"] <span aria-hidden="true">→</span></a>
                </article>

                <article class="feature-card">
                    <h3>@Localizer["Home.CompareTitle"]</h3>
                    <p>@Localizer["Home.CompareDescription"]</p>
                    <a href="/compare">@Localizer["Home.OpenComparison"] <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </div>

        <section class="country-selection" aria-labelledby="country-heading">
            <div class="section-heading">
                <p class="eyebrow">@Localizer["Home.ExploreByLocation"]</p>
                <h2 id="country-heading">@Localizer["Home.ChooseCountry"]</h2>
            </div>

            <div class="country-grid">
                @foreach (var country in CountryVisibility.GetVisibleCountries(Catalog, HostEnvironment.IsDevelopment()))
                {
                    var countryDisplayName = Localizer[CatalogLocalizationKeyResolver.CountryName(country)].Value;
                    var countryLocationName = Localizer[$"{CatalogLocalizationKeyResolver.CountryName(country)}.In"].Value;

                    <article class="country-card">
                        <h3 class="country-name">
                            <span>@countryDisplayName</span>
                            <span class="country-flag" aria-hidden="true">@CountryFlag(country.Slug)</span>
                        </h3>
                        <p>@Localizer["Home.CountryDescription", countryLocationName]</p>
                        <a href="/countries/@country.Slug">
                            @Localizer["Home.ExploreCountry", countryDisplayName] <span aria-hidden="true">→</span>
                        </a>
                    </article>
                }
            </div>
        </section>

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>

@code {
    private static string CountryFlag(string slug) => slug switch
    {
        "denmark" => "🇩🇰",
        "germany" => "🇩🇪",
        "poland" => "🇵🇱",
        "czechia" => "🇨🇿",
        "spain" => "🇪🇸",
        "sweden" => "🇸🇪",
        "netherlands" => "🇳🇱",
        _ => string.Empty
    };
}
