@page "/"

<PageTitle>Refugee Navigator Europe</PageTitle>

<main id="main-content" class="landing-page">
    <div class="page-content">
        <header class="hero">
            <p class="eyebrow">A guide to getting settled</p>
            <h1>Refugee Navigator Europe</h1>
            <p class="hero-subtitle">Practical information for Ukrainians under temporary protection in Europe.</p>
        </header>

        <section class="introduction" aria-labelledby="introduction-heading">
            <h2 id="introduction-heading">Find practical guidance</h2>
            <p>Explore essential information about temporary protection, employment, healthcare, housing, education, and social assistance.</p>
            <p>Information is organized by country and supported by official sources.</p>
        </section>

        <section class="country-selection" aria-labelledby="country-heading">
            <div class="section-heading">
                <p class="eyebrow">Explore by location</p>
                <h2 id="country-heading">Choose a country</h2>
            </div>

            <div class="country-grid">
                <article class="country-card">
                    <h3>Denmark</h3>
                    <p>Explore practical information about living in Denmark under temporary protection.</p>
                    <a href="/countries/denmark" aria-label="Explore practical information for Denmark">
                        Explore Denmark <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="country-card">
                    <h3>Germany</h3>
                    <p>Explore practical information about living in Germany under temporary protection.</p>
                    <a href="/countries/germany" aria-label="Explore practical information for Germany">
                        Explore Germany <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="country-card">
                    <h3>Poland</h3>
                    <p>Explore practical information about living in Poland under temporary protection.</p>
                    <a href="/countries/poland" aria-label="Explore practical information for Poland">
                        Explore Poland <span aria-hidden="true">→</span>
                    </a>
                </article>
            </div>
        </section>

        <footer class="information-note">
            <p>Information may change. Always confirm important requirements with official authorities.</p>
        </footer>
    </div>
</main>
