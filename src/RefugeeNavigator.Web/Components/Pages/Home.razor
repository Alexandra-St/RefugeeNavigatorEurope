@page "/"
@using RefugeeNavigator.Data
@inject CatalogData Catalog
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Home.PageTitle"]</PageTitle>

<main id="main-content" class="landing-page">
    <div class="page-content">
        <header class="hero">
            <p class="eyebrow">@Localizer["Home.Eyebrow"]</p>
            <h1>Refugee Navigator Europe</h1>
            <p class="hero-subtitle">@Localizer["Home.HeroSubtitle"]</p>
        </header>

        <section class="introduction" aria-labelledby="introduction-heading">
            <h2 id="introduction-heading">@Localizer["Home.FindGuidance"]</h2>
            <p>@Localizer["Home.IntroductionDescription"]</p>
            <p>@Localizer["Home.OfficialSources"]</p>
        </section>

        <section class="feature-previews" aria-labelledby="feature-previews-heading">
            <div class="section-heading">
                <h2 id="feature-previews-heading">@Localizer["Home.FeaturePreviewsHeading"]</h2>
            </div>

            <div class="feature-grid">
                <article class="feature-card">
                    <div class="feature-card-heading">
                        <h3>@Localizer["Home.SearchTitle"]</h3>
                        <span class="preview-badge">@Localizer["Common.Preview"]</span>
                    </div>
                    <p>@Localizer["Home.SearchDescription"]</p>
                    <a href="/search">@Localizer["Home.OpenSearchPreview"] <span aria-hidden="true">→</span></a>
                </article>

                <article class="feature-card">
                    <div class="feature-card-heading">
                        <h3>@Localizer["Home.CompareTitle"]</h3>
                        <span class="preview-badge">@Localizer["Common.Preview"]</span>
                    </div>
                    <p>@Localizer["Home.CompareDescription"]</p>
                    <a href="/compare">@Localizer["Home.OpenComparePreview"] <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </section>

        <section class="country-selection" aria-labelledby="country-heading">
            <div class="section-heading">
                <p class="eyebrow">@Localizer["Home.ExploreByLocation"]</p>
                <h2 id="country-heading">@Localizer["Home.ChooseCountry"]</h2>
            </div>

            <div class="country-grid">
                @foreach (var country in Catalog.Countries)
                {
                    var countryDisplayName = Localizer[CatalogLocalizationKeyResolver.CountryName(country)].Value;

                    <article class="country-card">
                        <h3>@countryDisplayName</h3>
                        <p>@Localizer["Home.CountryDescription", countryDisplayName]</p>
                        <a href="/countries/@country.Slug" aria-label="@Localizer["Home.CountryLinkLabel", countryDisplayName]">
                            @Localizer["Home.ExploreCountry", countryDisplayName] <span aria-hidden="true">→</span>
                        </a>
                    </article>
                }
            </div>
        </section>

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>
