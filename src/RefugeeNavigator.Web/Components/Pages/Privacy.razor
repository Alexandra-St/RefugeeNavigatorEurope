@page "/privacy"
@page "/en/privacy"
@page "/uk/privacy"
@page "/ru/privacy"
@inject IStringLocalizer<SharedResource> Localizer

<StaticPageSeo Path="/privacy" Title="@Localizer["Privacy.PageTitle"].Value"
               Description="@Localizer["Privacy.MetaDescription"].Value" />

<main id="main-content" class="legal-page">
    <article class="legal-content">
        <header class="legal-header">
            <h1>@Localizer["Privacy.Heading"]</h1>
            <p>@Localizer["Privacy.Introduction"]</p>
        </header>

        <section aria-labelledby="privacy-operator"><h2 id="privacy-operator">@Localizer["Privacy.OperatorTitle"]</h2><p>@Localizer["Privacy.Operator"] <a href="@LocalizedUrl.ForCurrentCulture("/contact", CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)">@Localizer["Privacy.ContactLink"]</a></p></section>
        <section aria-labelledby="privacy-technical"><h2 id="privacy-technical">@Localizer["Privacy.TechnicalTitle"]</h2><p>@Localizer["Privacy.Technical"]</p></section>
        <section aria-labelledby="privacy-preferences"><h2 id="privacy-preferences">@Localizer["Privacy.PreferencesTitle"]</h2><p>@Localizer["Privacy.Preferences"]</p></section>
        <section aria-labelledby="privacy-contact"><h2 id="privacy-contact">@Localizer["Privacy.ContactTitle"]</h2><p>@Localizer["Privacy.ContactData"]</p><p>@Localizer["Privacy.LegalBasis"]</p><p>@Localizer["Privacy.Processors"]</p></section>
        <section aria-labelledby="privacy-transfers"><h2 id="privacy-transfers">@Localizer["Privacy.TransfersTitle"]</h2><p>@Localizer["Privacy.Transfers"]</p></section>
        <section aria-labelledby="privacy-retention"><h2 id="privacy-retention">@Localizer["Privacy.RetentionTitle"]</h2><p>@Localizer["Privacy.Retention"]</p></section>
        <section aria-labelledby="privacy-rights"><h2 id="privacy-rights">@Localizer["Privacy.RightsTitle"]</h2><p>@Localizer["Privacy.Rights"] <a href="https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng/" target="_blank" rel="noopener noreferrer">@Localizer["Privacy.Gdpr"]</a> · <a href="https://commission.europa.eu/law/law-topic/data-protection/information-individuals_en" target="_blank" rel="noopener noreferrer">@Localizer["Privacy.EuGuidance"]</a></p><p>@Localizer["Privacy.Complaints"] <a href="https://www.cnpd.pt/" target="_blank" rel="noopener noreferrer">CNPD</a> · <a href="https://www.edpb.europa.eu/about-edpb/about-edpb/members_en" target="_blank" rel="noopener noreferrer">@Localizer["Privacy.AuthorityGuide"]</a></p></section>
        <section aria-labelledby="privacy-links"><h2 id="privacy-links">@Localizer["Privacy.ThirdPartiesTitle"]</h2><p>@Localizer["Privacy.ThirdParties"]</p>
            <ul class="legal-provider-links">
                <li><a href="https://render.com/privacy" target="_blank" rel="noopener noreferrer">Render — @Localizer["Privacy.ProviderPrivacy"]</a></li>
                <li><a href="https://render.com/docs/logging" target="_blank" rel="noopener noreferrer">Render — @Localizer["Privacy.ProviderLogs"]</a></li>
                <li><a href="https://render.com/dpa" target="_blank" rel="noopener noreferrer">Render — @Localizer["Privacy.ProviderDpa"]</a></li>
                <li><a href="https://formspree.io/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Formspree — @Localizer["Privacy.ProviderPrivacy"]</a></li>
                <li><a href="https://formspree.io/security/" target="_blank" rel="noopener noreferrer">Formspree — @Localizer["Privacy.ProviderSecurity"]</a></li>
                <li><a href="https://proton.me/mail/privacy-policy" target="_blank" rel="noopener noreferrer">Proton Mail — @Localizer["Privacy.ProviderPrivacy"]</a></li>
                <li><a href="https://proton.me/legal/terms" target="_blank" rel="noopener noreferrer">Proton — @Localizer["Privacy.ProviderTerms"]</a></li>
                <li><a href="https://proton.me/legal/dpa" target="_blank" rel="noopener noreferrer">Proton — @Localizer["Privacy.ProviderDpa"]</a></li>
                <li><a href="https://more.ko-fi.com/privacy" target="_blank" rel="noopener noreferrer">Ko-fi — @Localizer["Privacy.ProviderPrivacy"]</a></li>
                <li><a href="https://commission.europa.eu/law/law-topic/data-protection/international-dimension-data-protection/adequacy-decisions_en" target="_blank" rel="noopener noreferrer">@Localizer["Privacy.SwitzerlandAdequacy"]</a></li>
            </ul>
        </section>
    </article>
</main>
