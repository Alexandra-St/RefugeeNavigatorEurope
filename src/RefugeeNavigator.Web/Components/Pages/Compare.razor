@page "/compare"
@using System.Globalization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.WebUtilities
@using RefugeeNavigator.Data
@using RefugeeNavigator.Domain
@using RefugeeNavigator.Web.Content
@using RefugeeNavigator.Web.Comparison
@using RefugeeNavigator.Web.Localization
@inject CatalogData Catalog
@inject ComparisonFactCatalog ComparisonFacts
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Compare.PageTitle"]</PageTitle>

<HomeLink Placement="top" />

<main id="main-content" class="compare-page">
    <div class="page-content">
        <header class="page-heading">
            <h1>@Localizer["Compare.Heading"]</h1>
            <p class="description">@Localizer["Compare.Description"]</p>
        </header>

        <form class="compare-form" method="get" action="/compare">
            <div class="selection-grid">
                <div class="selection-field">
                    <label for="country-one">@Localizer["Compare.CountryOne"]</label>
                    <select id="country-one" name="country1" required>
                        <option value="">@Localizer["Compare.SelectCountry"]</option>
                        @foreach (var country in Catalog.Countries.Where(country => CountryComparisonTopicMap.SupportedCountrySlugs.Contains(country.Slug)))
                        {
                            <option value="@country.Slug" selected="@IsSelected(country.Slug, CountryOneSlug)">@Localizer[CatalogLocalizationKeyResolver.CountryName(country)]</option>
                        }
                    </select>
                </div>
                <div class="selection-field">
                    <label for="country-two">@Localizer["Compare.CountryTwo"]</label>
                    <select id="country-two" name="country2" required>
                        <option value="">@Localizer["Compare.SelectCountry"]</option>
                        @foreach (var country in Catalog.Countries.Where(country => CountryComparisonTopicMap.SupportedCountrySlugs.Contains(country.Slug)))
                        {
                            <option value="@country.Slug" selected="@IsSelected(country.Slug, CountryTwoSlug)">@Localizer[CatalogLocalizationKeyResolver.CountryName(country)]</option>
                        }
                    </select>
                </div>
                <div class="selection-field">
                    <label for="category">@Localizer["Compare.Category"]</label>
                    <select id="category" name="category" required>
                        <option value="">@Localizer["Compare.SelectCategory"]</option>
                        <option value="all" selected="@IsSelected("all", CategorySlug)">@Localizer["Compare.AllCategories"]</option>
                        @foreach (var category in Catalog.Categories)
                        {
                            <option value="@category.Slug" selected="@IsSelected(category.Slug, CategorySlug)">@Localizer[CatalogLocalizationKeyResolver.CategoryName(category)]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit">@Localizer["Compare.Submit"]</button>
                <a class="reset-link" href="/compare">@Localizer["Compare.Reset"]</a>
            </div>
        </form>

@{
    Microsoft.AspNetCore.Components.RenderFragment RenderArticleTopics(string categorySlug) => @<text>
                @foreach (var topic in CountryComparisonTopicMap.ForCategory(categorySlug))
                {
                    <section class="comparison-topic" aria-labelledby="topic-@topic.ResourceKey.Replace('.', '-')">
                        <h2 id="topic-@topic.ResourceKey.Replace('.', '-')">@Localizer[topic.ResourceKey]</h2>
                        <div class="topic-columns">
                            @foreach (var country in new[] { SelectedCountryOne!, SelectedCountryTwo! })
                            {
                                var countryName = Localizer[CatalogLocalizationKeyResolver.CountryName(country)];
                                var article = GetArticle(topic, country);
                                <article class="topic-country" aria-label="@Localizer["Compare.CountryPanelHeading", countryName]">
                                    <h3>@Localizer["Compare.CountryPanelHeading", countryName]</h3>
                                    @if (article?.Translation is { VerificationStatus: VerificationStatus.Verified } translation)
                                    {
                                        <h4 class="article-title">@translation.Title</h4>
                                        <p class="article-summary">@translation.Summary</p>
                                        <dl class="article-metadata">
                                            <div>
                                                <dt>@Localizer["Compare.LastUpdated"]</dt>
                                                <dd><time datetime="@translation.LastUpdatedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(translation.LastUpdatedAt)</time></dd>
                                            </div>
                                        </dl>
                                        <details class="article-details">
                                            <summary>
                                                <span class="when-closed">@Localizer["Compare.ReadDetails"]</span>
                                                <span class="when-open">@Localizer["Compare.HideDetails"]</span>
                                            </summary>
                                            <div class="article-body">
                                                @foreach (var block in ArticleContentFormatter.Parse(translation.Content))
                                                {
                                                    @switch (block.Kind)
                                                    {
                                                        case ArticleContentBlockKind.Heading:
                                                            <h5>@block.Text</h5>
                                                            break;
                                                        case ArticleContentBlockKind.UnorderedList:
                                                            <ul>
                                                                @foreach (var listItem in block.Items)
                                                                {
                                                                    <li>@listItem</li>
                                                                }
                                                            </ul>
                                                            break;
                                                        default:
                                                            <p>@block.Text</p>
                                                            break;
                                                    }
                                                }
                                            </div>
                                        </details>
                                        <a class="article-link" href="/countries/@country.Slug/categories/@topic.CategorySlug#entry-@article.Entry!.Id.ToString("N")">@Localizer["Compare.OpenArticle"]</a>
                                    }
                                    else
                                    {
                                        <div class="unavailable-state">
                                            <p>@Localizer["Compare.InformationUnavailable"]</p>
                                        </div>
                                    }

                                    @if (article?.Sources.Count > 0)
                                    {
                                        <details class="source-details">
                                            <summary>@Localizer["Compare.OfficialSources"] (@article.Sources.Count)</summary>
                                            <ul>
                                                @foreach (var source in article.Sources)
                                                {
                                                    var (sourceTitlePrefix, sourceTitleSuffix) = SplitFinalTitleWord(source.Title);
                                                    <li>
                                                        <a href="@source.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceTitlePrefix<span class="external-link-final-word">@sourceTitleSuffix<span aria-hidden="true" class="external-link-icon">↗</span></span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                        <span class="source-checked">@Localizer["Compare.SourceChecked"] <time datetime="@source.LastCheckedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(source.LastCheckedAt)</time></span>
                                                    </li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
    </text>;

    Microsoft.AspNetCore.Components.RenderFragment fullArticleComparison = @<section class="comparison" aria-label="@Localizer["Compare.PanelsHeading"]">
        @if (IsAllCategories)
        {
            @foreach (var category in Catalog.Categories)
            {
                <details class="full-article-category">
                    <summary>@Localizer[CatalogLocalizationKeyResolver.CategoryName(category)]</summary>
                    @RenderArticleTopics(category.Slug)
                </details>
            }
        }
        else
        {
            @RenderArticleTopics(SelectedCategory!.Slug)
        }
    </section>;

    Microsoft.AspNetCore.Components.RenderFragment RenderStructuredTopics(string categorySlug, bool allCategoriesMode) => @<text>
        @foreach (var topic in ComparisonFacts.Topics.Where(item => item.CategorySlug == categorySlug))
        {
            var topicHeadingId = StructuredTopicHeadingId(topic);
            <section class="structured-topic" aria-labelledby="@topicHeadingId">
                @if (allCategoriesMode)
                {
                    <h4 id="@topicHeadingId">@Localizer[topic.TopicResourceKey]</h4>
                }
                else
                {
                    <h3 id="@topicHeadingId">@Localizer[topic.TopicResourceKey]</h3>
                }
                @foreach (var aspect in topic.Aspects)
                {
                    var aspectHeadingId = StructuredAspectHeadingId(topic, aspect);
                    <section class="structured-aspect" aria-labelledby="@aspectHeadingId">
                        @if (allCategoriesMode)
                        {
                            <h5 id="@aspectHeadingId">@Localizer[aspect.QuestionResourceKey]</h5>
                        }
                        else
                        {
                            <h4 id="@aspectHeadingId">@Localizer[aspect.QuestionResourceKey]</h4>
                        }
                        <div class="structured-columns">
                            @foreach (var country in new[] { SelectedCountryOne!, SelectedCountryTwo! })
                            {
                                var fact = aspect.Facts.Single(item => item.CountrySlug == country.Slug);
                                var countryName = Localizer[CatalogLocalizationKeyResolver.CountryName(country)];
                                <article class="structured-country" aria-label="@Localizer["Compare.CountryPanelHeading", countryName]">
                                    @if (allCategoriesMode)
                                    {
                                        <h6>@countryName</h6>
                                    }
                                    else
                                    {
                                        <h5>@countryName</h5>
                                    }
                                    @if (fact.Status == ComparisonFactStatus.Draft)
                                    {
                                        <span class="draft-label">@Localizer["Compare.DraftStatus"]</span>
                                    }
                                    <p>@FactText(fact)</p>
                                    @if (AvailableFactSources(fact).Count > 0)
                                    {
                                        <details class="fact-sources">
                                            <summary>@Localizer["Compare.FactSources"] (@AvailableFactSources(fact).Count)</summary>
                                            <ul>
                                                @foreach (var source in AvailableFactSources(fact))
                                                {
                                                    var (sourceTitlePrefix, sourceTitleSuffix) = SplitFinalTitleWord(source.Title);
                                                    <li><a href="@source.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceTitlePrefix<span class="external-link-final-word">@sourceTitleSuffix<span aria-hidden="true" class="external-link-icon">↗</span></span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a><span>@Localizer["Compare.SourceChecked"] <time datetime="@source.LastCheckedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(source.LastCheckedAt)</time></span></li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            </section>
        }
    </text>;
}

        @if (SelectionMessage is { } message)
        {
            <p class="selection-message" role="status">@Localizer[message]</p>
        }
        else if (SelectedCountryOne is null || SelectedCountryTwo is null || !HasValidCategorySelection)
        {
            <section class="selection-state" aria-live="polite">
                <h2>@Localizer["Compare.SelectionInstructionsHeading"]</h2>
                <p>@Localizer["Compare.SelectionInstructions"]</p>
            </section>
        }
        else
        {
            <aside class="comparison-note" aria-label="@Localizer["Compare.AboutHeading"]">
                <h2>@Localizer["Compare.AboutHeading"]</h2>
                <p>@Localizer["Compare.ScopeNotice"]</p>
            </aside>

            @if (HostEnvironment.IsDevelopment() || IsStructuredCatalogApproved)
            {
                @if (HostEnvironment.IsDevelopment() && !IsStructuredCatalogApproved)
                {
                    <aside class="draft-preview-notice" role="note">
                        <strong>@Localizer["Compare.DraftPreviewHeading"]</strong>
                        <p>@Localizer["Compare.DraftPreviewNotice"]</p>
                    </aside>
                }

                <section class="structured-comparison" aria-label="@Localizer["Compare.StructuredHeading"]">
                    <h2>@Localizer["Compare.StructuredHeading"]</h2>
                    @if (IsAllCategories)
                    {
                        @foreach (var category in Catalog.Categories)
                        {
                            <section class="structured-category" aria-labelledby="@StructuredCategoryHeadingId(category)">
                                <h3 id="@StructuredCategoryHeadingId(category)">@Localizer[CatalogLocalizationKeyResolver.CategoryName(category)]</h3>
                                @RenderStructuredTopics(category.Slug, allCategoriesMode: true)
                            </section>
                        }
                    }
                    else
                    {
                        @RenderStructuredTopics(SelectedCategory!.Slug, allCategoriesMode: false)
                    }
                </section>
            }



            @if (IsAllCategories)
            {
                <details class="full-article-comparison">
                    <summary>@Localizer["Compare.ReadFullArticles"]</summary>
                    @fullArticleComparison
                </details>
            }
            else if (HostEnvironment.IsDevelopment() || IsStructuredCatalogApproved)
            {
                <details class="full-article-comparison">
                    <summary>@Localizer["Compare.ReadFullArticles"]</summary>
                    @fullArticleComparison
                </details>
            }
            else
            {
                @fullArticleComparison
            }
        }

        <HomeLink Placement="bottom" />

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>

@code {
    private IReadOnlyDictionary<string, Microsoft.Extensions.Primitives.StringValues> QueryParameters =>
        QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

    private string? CountryOneSlug => QueryParameters.GetValueOrDefault("country1").FirstOrDefault();

    private string? CountryTwoSlug => QueryParameters.GetValueOrDefault("country2").FirstOrDefault();

    private string? CategorySlug => QueryParameters.GetValueOrDefault("category").FirstOrDefault();

    private Country? SelectedCountryOne => FindCountry(CountryOneSlug);

    private Country? SelectedCountryTwo => FindCountry(CountryTwoSlug);

    private InformationCategory? SelectedCategory => Catalog.Categories.FirstOrDefault(category =>
        string.Equals(category.Slug, CategorySlug, StringComparison.OrdinalIgnoreCase));

    private bool IsAllCategories => string.Equals(CategorySlug, "all", StringComparison.OrdinalIgnoreCase);

    private bool HasValidCategorySelection => SelectedCategory is not null || IsAllCategories;

    private IEnumerable<CountryComparisonFact> SelectedStructuredFacts => ComparisonFacts.Topics
        .Where(topic => IsAllCategories || string.Equals(topic.CategorySlug, SelectedCategory?.Slug, StringComparison.OrdinalIgnoreCase))
        .SelectMany(topic => topic.Aspects)
        .SelectMany(aspect => aspect.Facts)
        .Where(fact => fact.CountrySlug == SelectedCountryOne?.Slug || fact.CountrySlug == SelectedCountryTwo?.Slug);

    private bool IsStructuredCatalogApproved => SelectedStructuredFacts.Any() &&
        SelectedStructuredFacts.All(fact => fact.Status == ComparisonFactStatus.Approved);

    private string? SelectionMessage
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(CountryOneSlug) && SelectedCountryOne is null ||
                !string.IsNullOrWhiteSpace(CountryTwoSlug) && SelectedCountryTwo is null)
            {
                return "Compare.InvalidCountry";
            }

            if (!string.IsNullOrWhiteSpace(CategorySlug) && !HasValidCategorySelection)
            {
                return "Compare.InvalidCategory";
            }

            if (SelectedCountryOne is not null && SelectedCountryTwo is not null &&
                SelectedCountryOne.Id == SelectedCountryTwo.Id)
            {
                return "Compare.SameCountry";
            }

            return null;
        }
    }

    private static bool IsSelected(string slug, string? selectedSlug) =>
        string.Equals(slug, selectedSlug, StringComparison.OrdinalIgnoreCase);

    private static string StructuredCategoryHeadingId(InformationCategory category) =>
        $"structured-category-{category.Slug}";

    private static string StructuredTopicHeadingId(ComparisonTopicFacts topic) =>
        $"structured-topic-{topic.CategorySlug}-{topic.TopicResourceKey.Replace('.', '-')}";

    private static string StructuredAspectHeadingId(ComparisonTopicFacts topic, ComparisonAspect aspect) =>
        $"structured-aspect-{topic.CategorySlug}-{topic.TopicResourceKey.Replace('.', '-')}-{aspect.Id}";

    private Country? FindCountry(string? slug) => string.IsNullOrWhiteSpace(slug)
        ? null
        : Catalog.Countries.FirstOrDefault(country =>
            string.Equals(country.Slug, slug, StringComparison.OrdinalIgnoreCase));

    private ComparisonArticle? GetArticle(CountryComparisonTopic topic, Country country)
    {
        var entryId = CountryComparisonTopicMap.EntryIdFor(topic, country.Slug);
        var entry = Catalog.InformationEntries.SingleOrDefault(item => item.Id == entryId);
        if (entry is null)
        {
            return null;
        }

        var languageCode = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var translation = Catalog.InformationEntryTranslations.SingleOrDefault(item =>
            item.InformationEntryId == entry.Id && item.LanguageCode == languageCode);
        var sources = Catalog.OfficialSources.Where(source => source.InformationEntryId == entry.Id).ToArray();
        return new ComparisonArticle(entry, translation, sources);
    }

    private static string FormatDate(DateTimeOffset value) => value.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private static (string Prefix, string Suffix) SplitFinalTitleWord(string title)
    {
        var separator = title.LastIndexOf(' ');
        return separator < 0 ? (string.Empty, title) : (title[..(separator + 1)], title[(separator + 1)..]);
    }

    private string FactText(CountryComparisonFact fact)
    {
        var translation = Catalog.InformationEntryTranslations.SingleOrDefault(item =>
            item.InformationEntryId == fact.InformationEntryId &&
            item.LanguageCode == CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
        var hasArticle = Catalog.InformationEntries.Any(entry => entry.Id == fact.InformationEntryId);
        var hasOwnedSources = AvailableFactSources(fact).Count > 0;
        var verifiedForPublication = translation?.VerificationStatus == VerificationStatus.Verified;
        var draftPreview = HostEnvironment.IsDevelopment() &&
            fact.Status == ComparisonFactStatus.Draft &&
            translation?.VerificationStatus == VerificationStatus.NeedsReview;

        return fact.IsAvailable && hasArticle && hasOwnedSources && (verifiedForPublication || draftPreview)
            ? fact.Values[CultureInfo.CurrentUICulture.TwoLetterISOLanguageName]
            : Localizer["Compare.NotEstablishedInReviewedSources"].Value;
    }

    private IReadOnlyList<OfficialSource> AvailableFactSources(CountryComparisonFact fact) =>
        Catalog.OfficialSources.Where(source => fact.OfficialSourceIds.Contains(source.Id) && source.InformationEntryId == fact.InformationEntryId).ToArray();

    private sealed record ComparisonArticle(
        InformationEntry Entry,
        InformationEntryTranslation? Translation,
        IReadOnlyList<OfficialSource> Sources);
}
