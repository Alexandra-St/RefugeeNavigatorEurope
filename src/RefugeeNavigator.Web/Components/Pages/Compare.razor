@page "/compare"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Compare.PageTitle"]</PageTitle>

<main id="main-content" class="preview-page">
    <div class="page-content">
        <section class="preview-card" aria-labelledby="preview-heading">
            <p class="eyebrow">@Localizer["Common.Preview"]</p>
            <h1 id="preview-heading">@Localizer["Compare.Heading"]</h1>
            <p class="description">@Localizer["Compare.Description"]</p>
            <p class="preview-notice">@Localizer["Compare.PreviewNotice"]</p>
            <a class="home-link" href="/">@Localizer["Compare.BackHome"]</a>
        </section>

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>
