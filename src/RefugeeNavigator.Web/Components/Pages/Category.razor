@page "/countries/{CountrySlug}/categories/{CategorySlug}"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

@if (CountryName is { } countryName && CategoryDetails is { } category)
{
    <PageTitle>@Localizer["Category.PageTitle", category.Name, countryName]</PageTitle>

    <main id="main-content" class="category-page">
        <div class="page-content">
            <a class="back-link" href="/countries/@CountrySlug" aria-label="@Localizer["Category.BackToCountry", countryName]"><span aria-hidden="true">←</span> @Localizer["Category.BackToCountry", countryName]</a>

            <header class="category-header">
                <p class="eyebrow">@countryName</p>
                <h1>@category.Name</h1>
                <p class="subtitle">@category.Description</p>
            </header>

            <section class="content-placeholder" aria-labelledby="placeholder-heading">
                <h2 id="placeholder-heading">@Localizer["Category.InformationComingSoon"]</h2>
                <p>@Localizer["Category.PlaceholderDescription"]</p>
            </section>

            <footer class="information-note">
                <p>@Localizer["Common.Disclaimer"]</p>
            </footer>
        </div>
    </main>
}

@code {
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    [Parameter]
    public string CategorySlug { get; set; } = string.Empty;

    private string? CountryName => CountrySlug switch
    {
        "denmark" => Localizer["Country.Denmark"].Value,
        "germany" => Localizer["Country.Germany"].Value,
        "poland" => Localizer["Country.Poland"].Value,
        _ => null
    };

    private (string Name, string Description)? CategoryDetails => CategorySlug switch
    {
        "temporary-protection" => (Localizer["Category.TemporaryProtection"].Value, Localizer["Category.TemporaryProtectionDescription"].Value),
        "employment" => (Localizer["Category.Employment"].Value, Localizer["Category.EmploymentDescription"].Value),
        "healthcare" => (Localizer["Category.Healthcare"].Value, Localizer["Category.HealthcareDescription"].Value),
        "housing" => (Localizer["Category.Housing"].Value, Localizer["Category.HousingDescription"].Value),
        "education" => (Localizer["Category.Education"].Value, Localizer["Category.EducationDescription"].Value),
        "social-assistance" => (Localizer["Category.SocialAssistance"].Value, Localizer["Category.SocialAssistanceDescription"].Value),
        _ => null
    };

    protected override void OnParametersSet()
    {
        if (CountryName is null || CategoryDetails is null)
        {
            Navigation.NotFound();
        }
    }
}
