@page "/countries/{CountrySlug}/categories/{CategorySlug}"
@page "/en/countries/{CountrySlug}/categories/{CategorySlug}"
@page "/uk/countries/{CountrySlug}/categories/{CategorySlug}"
@page "/ru/countries/{CountrySlug}/categories/{CategorySlug}"
@page "/en/articles/{CountrySlug}/{CategorySlug}/{ArticleKey}"
@page "/uk/articles/{CountrySlug}/{CategorySlug}/{ArticleKey}"
@page "/ru/articles/{CountrySlug}/{CategorySlug}/{ArticleKey}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Hosting
@using System.Globalization
@using RefugeeNavigator.Web.Content
@using RefugeeNavigator.Web.Guides
@using GuideDefinition = RefugeeNavigator.Web.Guides.StepByStepGuide
@using RefugeeNavigator.Data
@using RefugeeNavigator.Domain
@inject CatalogData Catalog
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer
@inject IServiceProvider Services

@if (Article is { } resolvedArticle)
{
    <SharedSeoMetadata Metadata="@ArticleSeo" Kind="StructuredPageKind.Article"
                       Parents="@BreadcrumbParents" DateModified="@resolvedArticle.Translation.LastUpdatedAt" />
}

@if (CountryName is { } countryName && CategoryDetails is { } category)
{
    @if (!IsStandaloneArticle)
    {
        var title = Localizer["Category.PageTitle", category.Name, countryName].Value;
        var metadata = Services.GetService<SeoMetadataGenerator>()?.CreateCategory(
            title, category.Description, Country!.Slug, SelectedCategory!.Slug);
        @if (metadata is not null)
        {
            <SharedSeoMetadata Metadata="@metadata" Kind="StructuredPageKind.CollectionPage"
                               Name="@category.Name" Parents="@BreadcrumbParents" />
        }
        else
        {
            <FilteredPageSeo Title="@title" />
        }
    }

    <HomeLink Placement="top" />

    <main id="main-content" class="category-page">
        <div class="page-content">
            <a class="back-link" href="@BackHref" aria-label="@BackLabel"><span aria-hidden="true">←</span> @BackLabel</a>

            <header class="category-header">
                @if (Article is { } article)
                {
                    <p class="eyebrow"><a href="@CountryHref">@countryName</a> · <a href="@BackHref">@category.Name</a></p>
                    <h1 id="article-title-@article.Entry.Id.ToString("N")">@article.Translation.Title</h1>
                }
                else
                {
                    <p class="eyebrow">@countryName</p>
                    <h1>@category.Name</h1>
                    <p class="subtitle">@category.Description</p>
                }
            </header>

            @if (GuideForCurrentCategory is not null)
            {
                <aside class="guide-callout" aria-labelledby="guide-callout-heading">
                    <div>
                        <h2 id="guide-callout-heading">@Localizer["Category.GuideCalloutTitle"]</h2>
                        <p>@Localizer["Category.GuideCalloutDescription"]</p>
                    </div>
                    <a href="@GuideHref">@Localizer["Category.GuideCalloutLink"]</a>
                </aside>
            }

            @if (_renderedEntries.Count == 0)
            {
                <section class="content-placeholder" aria-labelledby="placeholder-heading">
                    <h2 id="placeholder-heading">@Localizer["Category.InformationComingSoon"]</h2>
                    <p>@Localizer["Category.PlaceholderDescription"]</p>
                </section>
            }
            else
            {
                <section class="information-entries" aria-label="@category.Name">
                    @foreach (var item in _renderedEntries)
                    {
                        <article class="information-entry" aria-labelledby="@ArticleLabelId(item.Entry.Id)" id="entry-@item.Entry.Id.ToString("N")">
                            @if (!IsStandaloneArticle)
                            {
                                var articleUrl = ArticleResolver.Generate(item.Entry, CurrentLanguage);
                                <h2 id="entry-heading-@item.Entry.Id.ToString("N")">
                                    @if (articleUrl is not null)
                                    {
                                        <a href="@articleUrl">@item.Translation.Title</a>
                                    }
                                    else
                                    {
                                        @item.Translation.Title
                                    }
                                </h2>
                            }
                            <p class="entry-summary">
                                @foreach (var part in ArticleContentFormatter.ParseInline(item.Translation.Summary, item.Entry.Id, item.Sources))
                                {
                                    @RenderArticleInlinePart(part)
                                }
                            </p>
                            @{
                                var contentBlocks = ArticleContentFormatter.Parse(item.Translation.Content, item.Entry.Id, item.Sources);
                                var sectionBlocks = contentBlocks.Where(block => block.Kind == ArticleContentBlockKind.Heading).ToArray();
                            }
                            @if (sectionBlocks.Length >= 3)
                            {
                                <details class="article-toc">
                                    <summary>@Localizer["Category.ArticleContents", sectionBlocks.Length]</summary>
                                    <nav aria-label="@Localizer["Category.ArticleContentsLabel"]">
                                        <ol>
                                            @foreach (var section in sectionBlocks)
                                            {
                                                <li><a href="@SectionHref(section.AnchorId)">@section.Text</a></li>
                                            }
                                        </ol>
                                    </nav>
                                </details>
                            }
                            @foreach (var block in contentBlocks)
                            {
                                @switch (block.Kind)
                                {
                                    case ArticleContentBlockKind.Heading:
                                        <h3 class="entry-section-heading" id="@block.AnchorId">@block.Text</h3>
                                        break;
                                    case ArticleContentBlockKind.UnorderedList:
                                        <ul class="entry-list">
                                            @foreach (var listItem in block.Items)
                                            {
                                                <li>
                                                    @foreach (var part in listItem)
                                                    {
                                                        if (part is ArticleContentSourceLink sourceLink)
                                                        {
                                                            <a class="article-source-link" href="@sourceLink.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceLink.Label<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                        }
                                                        else if (part is ArticleContentCode codePart)
                                                        {
                                                            <code class="article-inline-code">@codePart.Value</code>
                                                        }
                                                        else if (part is ArticleContentStrong strong)
                                                        {
                                                            <strong>@strong.Value</strong>
                                                        }
                                                        else if (part is ArticleContentText text)
                                                        {
                                                            @text.Value
                                                        }
                                                    }
                                                </li>
                                            }
                                        </ul>
                                        break;
                                    case ArticleContentBlockKind.Table:
                                        <div class="entry-table-wrapper" role="region" tabindex="0" aria-label="Article data table">
                                            <table class="entry-table">
                                                <thead>
                                                    <tr>
                                                        @for (var columnIndex = 0; columnIndex < block.TableHeaders!.Count; columnIndex++)
                                                        {
                                                            <th scope="col" class="@TableAlignmentClass(block.TableAlignments![columnIndex])">
                                                                @foreach (var part in block.TableHeaders[columnIndex])
                                                                {
                                                                    @RenderArticleInlinePart(part)
                                                                }
                                                            </th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in block.TableRows!)
                                                    {
                                                        <tr>
                                                            @for (var columnIndex = 0; columnIndex < row.Count; columnIndex++)
                                                            {
                                                                <td class="@TableAlignmentClass(block.TableAlignments![columnIndex])">
                                                                    @foreach (var part in row[columnIndex])
                                                                    {
                                                                        @RenderArticleInlinePart(part)
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        break;
                                    default:
                                        <p class="entry-content">
                                            @foreach (var part in block.InlineParts)
                                            {
                                                if (part is ArticleContentSourceLink sourceLink)
                                                {
                                                    <a class="article-source-link" href="@sourceLink.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceLink.Label<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                }
                                                else if (part is ArticleContentCode codePart)
                                                {
                                                    <code class="article-inline-code">@codePart.Value</code>
                                                }
                                                else if (part is ArticleContentStrong strong)
                                                {
                                                    <strong>@strong.Value</strong>
                                                }
                                                else if (part is ArticleContentText text)
                                                {
                                                    @text.Value
                                                }
                                            }
                                        </p>
                                        break;
                                }
                            }

                            <dl class="entry-metadata">
                                @if (Article is { } articleMetadata)
                                {
                                    <div>
                                        <dt>@Localizer["Article.ReviewStatus"]</dt>
                                        <dd>@Localizer[$"Category.Status.{articleMetadata.Translation.VerificationStatus}"]</dd>
                                    </div>
                                }
                                <div>
                                    <dt>@Localizer["Category.LastUpdated"]</dt>
                                    <dd><time datetime="@item.Translation.LastUpdatedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(item.Translation.LastUpdatedAt)</time></dd>
                                </div>
                            </dl>

                            @if (item.Sources.Count > 0)
                            {
                                <details class="entry-sources">
                                    <summary>@Localizer["Category.Sources"] (@item.Sources.Count)</summary>
                                    <ul>
                                        @foreach (var source in item.Sources)
                                        {
                                            var (sourceTitlePrefix, sourceTitleSuffix) = SplitFinalTitleWord(source.Title);
                                            <li>
                                                <a href="@source.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceTitlePrefix<span class="external-link-final-word">@sourceTitleSuffix<span aria-hidden="true" class="external-link-icon">↗</span></span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                <span class="source-checked">@Localizer["Category.SourceLastChecked"] <time datetime="@source.LastCheckedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(source.LastCheckedAt)</time></span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </article>
                    }
                </section>
            }

            <HomeLink Placement="bottom" />

            <footer class="information-note">
                <p>@Localizer["Common.Disclaimer"]</p>
            </footer>
        </div>
    </main>
}

@code {
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    [Parameter]
    public string CategorySlug { get; set; } = string.Empty;

    [Parameter]
    public string? ArticleKey { get; set; }

    private bool IsStandaloneArticle => !string.IsNullOrWhiteSpace(ArticleKey);
    private string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private ResolvedArticleUrl? Article { get; set; }
    private string BackHref => Article is { } article
        ? LocalizedUrl.ForCurrentCulture($"/countries/{article.Country.Slug}/categories/{article.Category.Slug}", CurrentLanguage)
        : LocalizedUrl.ForCurrentCulture($"/countries/{CountrySlug}", CurrentLanguage);
    private string CountryHref => Article is { } article
        ? LocalizedUrl.ForCurrentCulture($"/countries/{article.Country.Slug}", CurrentLanguage)
        : LocalizedUrl.ForCurrentCulture($"/countries/{CountrySlug}", CurrentLanguage);
    private string BackLabel => Article is null
        ? Localizer["Category.BackToCountry", CountryName ?? string.Empty].Value
        : Localizer["Article.BackToCategory", CategoryDetails?.Name ?? string.Empty].Value;
    private string ArticleLabelId(Guid id) => IsStandaloneArticle ? $"article-title-{id:N}" : $"entry-heading-{id:N}";
    private IReadOnlyList<SeoBreadcrumb> BreadcrumbParents
    {
        get
        {
            var countryPath = $"/countries/{Country!.Slug}";
            var parents = new List<SeoBreadcrumb>
            {
                new(Localizer["Common.Home"].Value, "/"),
                new(CountryName!, countryPath)
            };
            if (Article is not null)
                parents.Add(new(CategoryDetails!.Value.Name, $"{countryPath}/categories/{SelectedCategory!.Slug}"));
            return parents;
        }
    }

    private SeoMetadata? ArticleSeo => Article is { } article &&
        Services.GetService<SeoMetadataGenerator>() is { } seoGenerator &&
        Services.GetService<SeoTranslationAvailability>() is { } seoAvailability
        ? seoGenerator.Create(article.Translation.Title, ArticleDescription(article), article.Path,
            seoAvailability.Article(article.Entry.Id))
        : null;
    private ArticleUrlResolver ArticleResolver => Services.GetService<ArticleUrlResolver>() ?? new(Catalog);

    private string ArticleDescription(ResolvedArticleUrl article) => string.Concat(
        ArticleContentFormatter.ParseInline(article.Translation.Summary, article.Entry.Id,
                Catalog.OfficialSources.Where(source => source.InformationEntryId == article.Entry.Id).ToArray())
            .Select(part => part switch
            {
                ArticleContentText text => text.Value,
                ArticleContentStrong strong => strong.Value,
                ArticleContentCode code => code.Value,
                ArticleContentSourceLink sourceLink => sourceLink.Label,
                _ => string.Empty
            })).Trim();

    private IReadOnlyList<RenderedInformationEntry> _renderedEntries = Array.Empty<RenderedInformationEntry>();

    private GuideDefinition? GuideForCurrentCategory
    {
        get
        {
            if (Country is not { } country || SelectedCategory is not { } category)
                return null;

            var guideCatalog = Services.GetService<StepByStepGuideCatalog>();
            var hostEnvironment = Services.GetService<IWebHostEnvironment>();
            if (guideCatalog is null || hostEnvironment is null)
                return null;

            return guideCatalog.Guides.FirstOrDefault(guide =>
                guide.CountryId == country.Id &&
                StepByStepGuideVisibility.CanRender(guide.EditorialStatus, hostEnvironment.IsDevelopment()) &&
                guide.Scenarios.SelectMany(scenario => scenario.Steps).Any(step =>
                    Catalog.InformationEntries.Any(entry => entry.Id == step.ArticleId && entry.CategoryId == category.Id)));
        }
    }

    private string? GuideHref => GuideForCurrentCategory is { } guide && Country is { } country
        ? LocalizedUrl.ForCurrentCulture($"/guides/{country.Slug}/{guide.Slug}", CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
        : null;

    private string SectionHref(string? anchorId)
    {
        if (string.IsNullOrWhiteSpace(anchorId))
        {
            throw new InvalidOperationException("Article section headings must have an anchor ID.");
        }

        var currentUri = new Uri(Navigation.Uri);
        return $"{currentUri.PathAndQuery}#{Uri.EscapeDataString(anchorId)}";
    }

    private Country? Country => CountryVisibility.GetVisibleCountries(Catalog, HostEnvironment.IsDevelopment()).FirstOrDefault(country =>
        string.Equals(country.Slug, CountrySlug, StringComparison.OrdinalIgnoreCase));

    private InformationCategory? SelectedCategory => Catalog.Categories.FirstOrDefault(category =>
        string.Equals(category.Slug, CategorySlug, StringComparison.OrdinalIgnoreCase));

    private string? CountryName => Country is { } country
        ? Localizer[CatalogLocalizationKeyResolver.CountryName(country)].Value
        : null;

    private (string Name, string Description)? CategoryDetails => SelectedCategory is { } category
        ? (
            Localizer[CatalogLocalizationKeyResolver.CategoryName(category)].Value,
            Localizer[CatalogLocalizationKeyResolver.CategoryDescription(category)].Value)
        : null;

    private IReadOnlyList<RenderedInformationEntry> GetRenderedEntries()
    {
        if (Country is not { } country || SelectedCategory is not { } category)
        {
            return Array.Empty<RenderedInformationEntry>();
        }

        var languageCode = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        if (languageCode is not ("uk" or "en" or "ru"))
        {
            throw new InvalidOperationException($"The current UI culture '{CultureInfo.CurrentUICulture.Name}' is not supported.");
        }

        var isProduction = Services.GetRequiredService<IWebHostEnvironment>().IsProduction();

        return Catalog.InformationEntries
            .Where(entry => entry.CountryId == country.Id && entry.CategoryId == category.Id)
            .Select(entry =>
            {
                var translation = Catalog.InformationEntryTranslations.SingleOrDefault(item =>
                    item.InformationEntryId == entry.Id && item.LanguageCode == languageCode)
                    ?? throw new InvalidOperationException(
                        $"Information entry '{entry.Id}' has no '{languageCode}' translation.");

                return (Entry: entry, Translation: translation);
            })
            .Where(item => !isProduction || item.Translation.VerificationStatus == VerificationStatus.Verified)
            .Select(item => new RenderedInformationEntry(
                item.Entry,
                item.Translation,
                Catalog.OfficialSources
                    .Where(source => source.InformationEntryId == item.Entry.Id)
                    .ToArray()))
            .ToArray();
    }

    private static string FormatDate(DateTimeOffset value) => value.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private static string TableAlignmentClass(ArticleContentColumnAlignment alignment) => alignment switch
    {
        ArticleContentColumnAlignment.Right => "align-right",
        ArticleContentColumnAlignment.Center => "align-center",
        _ => string.Empty
    };

    private RenderFragment RenderArticleInlinePart(ArticleContentInlinePart part) => builder =>
    {
        switch (part)
        {
            case ArticleContentSourceLink sourceLink:
                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "class", "article-source-link");
                builder.AddAttribute(2, "href", sourceLink.Url.AbsoluteUri);
                builder.AddAttribute(3, "target", "_blank");
                builder.AddAttribute(4, "rel", "noopener noreferrer");
                builder.AddContent(5, sourceLink.Label);
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "aria-hidden", "true");
                builder.AddContent(8, " ↗");
                builder.CloseElement();
                builder.OpenElement(9, "span");
                builder.AddAttribute(10, "class", "visually-hidden");
                builder.AddContent(11, $" ({Localizer["Common.OpensInNewTab"]})");
                builder.CloseElement();
                builder.CloseElement();
                break;
            case ArticleContentStrong strong:
                builder.OpenElement(12, "strong");
                builder.AddContent(13, strong.Value);
                builder.CloseElement();
                break;
            case ArticleContentCode code:
                builder.OpenElement(15, "code");
                builder.AddAttribute(16, "class", "article-inline-code");
                builder.AddContent(17, code.Value);
                builder.CloseElement();
                break;
            case ArticleContentText text:
                builder.AddContent(14, text.Value);
                break;
        }
    };

    private static (string Prefix, string Suffix) SplitFinalTitleWord(string title)
    {
        var separator = title.LastIndexOf(' ');
        return separator < 0 ? (string.Empty, title) : (title[..(separator + 1)], title[(separator + 1)..]);
    }

    private sealed record RenderedInformationEntry(
        InformationEntry Entry,
        InformationEntryTranslation Translation,
        IReadOnlyList<OfficialSource> Sources);

    protected override void OnParametersSet()
    {
        Article = null;
        if (IsStandaloneArticle)
        {
            Article = ArticleResolver.Resolve(CurrentLanguage, CountrySlug, CategorySlug, ArticleKey);
            if (Article is null)
            {
                _renderedEntries = Array.Empty<RenderedInformationEntry>();
                Navigation.NotFound();
                return;
            }

            _renderedEntries =
            [
                new RenderedInformationEntry(Article.Entry, Article.Translation,
                    Catalog.OfficialSources.Where(source => source.InformationEntryId == Article.Entry.Id).ToArray())
            ];
            return;
        }

        if (Country is null || SelectedCategory is null)
        {
            Navigation.NotFound();
            return;
        }

        _renderedEntries = GetRenderedEntries();
    }
}
