@page "/countries/{CountrySlug}/categories/{CategorySlug}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Hosting
@using System.Globalization
@using RefugeeNavigator.Web.Content
@using RefugeeNavigator.Web.Guides
@using GuideDefinition = RefugeeNavigator.Web.Guides.StepByStepGuide
@using RefugeeNavigator.Data
@using RefugeeNavigator.Domain
@inject CatalogData Catalog
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer
@inject IServiceProvider Services

@if (CountryName is { } countryName && CategoryDetails is { } category)
{
    <PageTitle>@Localizer["Category.PageTitle", category.Name, countryName]</PageTitle>

    <HomeLink Placement="top" />

    <main id="main-content" class="category-page">
        <div class="page-content">
            <a class="back-link" href="/countries/@CountrySlug" aria-label="@Localizer["Category.BackToCountry", countryName]"><span aria-hidden="true">←</span> @Localizer["Category.BackToCountry", countryName]</a>

            <header class="category-header">
                <p class="eyebrow">@countryName</p>
                <h1>@category.Name</h1>
                <p class="subtitle">@category.Description</p>
            </header>

            @if (GuideForCurrentCategory is not null)
            {
                <aside class="guide-callout" aria-labelledby="guide-callout-heading">
                    <div>
                        <h2 id="guide-callout-heading">@Localizer["Category.GuideCalloutTitle"]</h2>
                        <p>@Localizer["Category.GuideCalloutDescription"]</p>
                    </div>
                    <a href="@GuideHref">@Localizer["Category.GuideCalloutLink"]</a>
                </aside>
            }

            @if (_renderedEntries.Count == 0)
            {
                <section class="content-placeholder" aria-labelledby="placeholder-heading">
                    <h2 id="placeholder-heading">@Localizer["Category.InformationComingSoon"]</h2>
                    <p>@Localizer["Category.PlaceholderDescription"]</p>
                </section>
            }
            else
            {
                <section class="information-entries" aria-label="@category.Name">
                    @foreach (var item in _renderedEntries)
                    {
                        <article class="information-entry" aria-labelledby="entry-heading-@item.Entry.Id.ToString("N")" id="entry-@item.Entry.Id.ToString("N")">
                            <h2 id="entry-heading-@item.Entry.Id.ToString("N")">@item.Translation.Title</h2>
                            <p class="entry-summary">@item.Translation.Summary</p>
                            @{
                                var contentBlocks = ArticleContentFormatter.Parse(item.Translation.Content, item.Entry.Id, item.Sources);
                                var sectionBlocks = contentBlocks.Where(block => block.Kind == ArticleContentBlockKind.Heading).ToArray();
                            }
                            @if (sectionBlocks.Length >= 3)
                            {
                                <details class="article-toc">
                                    <summary>@Localizer["Category.ArticleContents", sectionBlocks.Length]</summary>
                                    <nav aria-label="@Localizer["Category.ArticleContentsLabel"]">
                                        <ol>
                                            @foreach (var section in sectionBlocks)
                                            {
                                                <li><a href="#@section.AnchorId">@section.Text</a></li>
                                            }
                                        </ol>
                                    </nav>
                                </details>
                            }
                            @foreach (var block in contentBlocks)
                            {
                                @switch (block.Kind)
                                {
                                    case ArticleContentBlockKind.Heading:
                                        <h3 class="entry-section-heading" id="@block.AnchorId">@block.Text</h3>
                                        break;
                                    case ArticleContentBlockKind.UnorderedList:
                                        <ul class="entry-list">
                                            @foreach (var listItem in block.Items)
                                            {
                                                <li>
                                                    @foreach (var part in listItem)
                                                    {
                                                        if (part is ArticleContentSourceLink sourceLink)
                                                        {
                                                            <a class="article-source-link" href="@sourceLink.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceLink.Label<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                        }
                                                        else if (part is ArticleContentText text)
                                                        {
                                                            @text.Value
                                                        }
                                                    }
                                                </li>
                                            }
                                        </ul>
                                        break;
                                    default:
                                        <p class="entry-content">
                                            @foreach (var part in block.InlineParts)
                                            {
                                                if (part is ArticleContentSourceLink sourceLink)
                                                {
                                                    <a class="article-source-link" href="@sourceLink.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceLink.Label<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                }
                                                else if (part is ArticleContentText text)
                                                {
                                                    @text.Value
                                                }
                                            }
                                        </p>
                                        break;
                                }
                            }

                            <dl class="entry-metadata">
                                <div>
                                    <dt>@Localizer["Category.LastUpdated"]</dt>
                                    <dd><time datetime="@item.Translation.LastUpdatedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(item.Translation.LastUpdatedAt)</time></dd>
                                </div>
                            </dl>

                            @if (item.Sources.Count > 0)
                            {
                                <details class="entry-sources">
                                    <summary>@Localizer["Category.Sources"] (@item.Sources.Count)</summary>
                                    <ul>
                                        @foreach (var source in item.Sources)
                                        {
                                            var (sourceTitlePrefix, sourceTitleSuffix) = SplitFinalTitleWord(source.Title);
                                            <li>
                                                <a href="@source.Url.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceTitlePrefix<span class="external-link-final-word">@sourceTitleSuffix<span aria-hidden="true" class="external-link-icon">↗</span></span><span class="visually-hidden"> (@Localizer["Common.OpensInNewTab"])</span></a>
                                                <span class="source-checked">@Localizer["Category.SourceLastChecked"] <time datetime="@source.LastCheckedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(source.LastCheckedAt)</time></span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </article>
                    }
                </section>
            }

            <HomeLink Placement="bottom" />

            <footer class="information-note">
                <p>@Localizer["Common.Disclaimer"]</p>
            </footer>
        </div>
    </main>
}

@code {
    [Parameter]
    public string CountrySlug { get; set; } = string.Empty;

    [Parameter]
    public string CategorySlug { get; set; } = string.Empty;

    private IReadOnlyList<RenderedInformationEntry> _renderedEntries = Array.Empty<RenderedInformationEntry>();

    private GuideDefinition? GuideForCurrentCategory
    {
        get
        {
            if (Country is not { } country || SelectedCategory is not { } category)
                return null;

            var guideCatalog = Services.GetService<StepByStepGuideCatalog>();
            var hostEnvironment = Services.GetService<IWebHostEnvironment>();
            if (guideCatalog is null || hostEnvironment is null)
                return null;

            return guideCatalog.Guides.FirstOrDefault(guide =>
                guide.CountryId == country.Id &&
                StepByStepGuideVisibility.CanRender(guide.EditorialStatus, hostEnvironment.IsDevelopment()) &&
                guide.Scenarios.SelectMany(scenario => scenario.Steps).Any(step =>
                    Catalog.InformationEntries.Any(entry => entry.Id == step.ArticleId && entry.CategoryId == category.Id)));
        }
    }

    private string? GuideHref => GuideForCurrentCategory is { } guide && Country is { } country
        ? $"/guides/{country.Slug}/{guide.Slug}"
        : null;

    private Country? Country => Catalog.Countries.FirstOrDefault(country =>
        string.Equals(country.Slug, CountrySlug, StringComparison.OrdinalIgnoreCase));

    private InformationCategory? SelectedCategory => Catalog.Categories.FirstOrDefault(category =>
        string.Equals(category.Slug, CategorySlug, StringComparison.OrdinalIgnoreCase));

    private string? CountryName => Country is { } country
        ? Localizer[CatalogLocalizationKeyResolver.CountryName(country)].Value
        : null;

    private (string Name, string Description)? CategoryDetails => SelectedCategory is { } category
        ? (
            Localizer[CatalogLocalizationKeyResolver.CategoryName(category)].Value,
            Localizer[CatalogLocalizationKeyResolver.CategoryDescription(category)].Value)
        : null;

    private IReadOnlyList<RenderedInformationEntry> GetRenderedEntries()
    {
        if (Country is not { } country || SelectedCategory is not { } category)
        {
            return Array.Empty<RenderedInformationEntry>();
        }

        var languageCode = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        if (languageCode is not ("uk" or "en" or "ru"))
        {
            throw new InvalidOperationException($"The current UI culture '{CultureInfo.CurrentUICulture.Name}' is not supported.");
        }

        var isProduction = Services.GetRequiredService<IWebHostEnvironment>().IsProduction();

        return Catalog.InformationEntries
            .Where(entry => entry.CountryId == country.Id && entry.CategoryId == category.Id)
            .Select(entry =>
            {
                var translation = Catalog.InformationEntryTranslations.SingleOrDefault(item =>
                    item.InformationEntryId == entry.Id && item.LanguageCode == languageCode)
                    ?? throw new InvalidOperationException(
                        $"Information entry '{entry.Id}' has no '{languageCode}' translation.");

                return (Entry: entry, Translation: translation);
            })
            .Where(item => !isProduction || item.Translation.VerificationStatus == VerificationStatus.Verified)
            .Select(item => new RenderedInformationEntry(
                item.Entry,
                item.Translation,
                Catalog.OfficialSources
                    .Where(source => source.InformationEntryId == item.Entry.Id)
                    .ToArray()))
            .ToArray();
    }

    private static string FormatDate(DateTimeOffset value) => value.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private static (string Prefix, string Suffix) SplitFinalTitleWord(string title)
    {
        var separator = title.LastIndexOf(' ');
        return separator < 0 ? (string.Empty, title) : (title[..(separator + 1)], title[(separator + 1)..]);
    }

    private sealed record RenderedInformationEntry(
        InformationEntry Entry,
        InformationEntryTranslation Translation,
        IReadOnlyList<OfficialSource> Sources);

    protected override void OnParametersSet()
    {
        if (Country is null || SelectedCategory is null)
        {
            Navigation.NotFound();
            return;
        }

        _renderedEntries = GetRenderedEntries();
    }
}
