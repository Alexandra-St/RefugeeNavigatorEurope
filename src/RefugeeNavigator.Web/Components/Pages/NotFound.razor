@page "/not-found"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["NotFound.PageTitle"]</PageTitle>

<HomeLink Placement="top" />

<main id="main-content" class="not-found-page">
    <div class="page-content">
        <section class="not-found-card" aria-labelledby="not-found-heading">
            <p class="eyebrow">404</p>
            <h1 id="not-found-heading">@Localizer["NotFound.Heading"]</h1>
            <p class="description">@Localizer["NotFound.Description"]</p>
        </section>

        <HomeLink Placement="bottom" />

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>
