@page "/search"
@using System.Globalization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.WebUtilities
@using RefugeeNavigator.Data
@using RefugeeNavigator.Domain
@using RefugeeNavigator.Web.Localization
@using RefugeeNavigator.Web.Search
@using RefugeeNavigator.Web.Content
@inject CatalogData Catalog
@inject IWebHostEnvironment HostEnvironment
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Search.PageTitle"]</PageTitle>

<HomeLink Placement="top" />

<main id="main-content" class="search-page">
    <div class="page-content">
        <header class="page-heading">
            <h1>@Localizer["Search.Heading"]</h1>
            <p class="description">@Localizer["Search.Description"]</p>
            <p class="scope-note">@Localizer["Search.Scope"]</p>
        </header>

        <form class="search-form" method="get" action="/search">
            <div class="query-field">
                <label for="search-query">@Localizer["Search.InputLabel"]</label>
                <input id="search-query" type="search" name="q" value="@Query" placeholder="@Localizer["Search.Placeholder"]" />
            </div>

            <div class="filters">
                <div class="filter-field">
                    <label for="country-filter">@Localizer["Search.CountryFilter"]</label>
                    <select id="country-filter" name="country">
                        <option value="">@Localizer["Search.AllCountries"]</option>
                        @foreach (var country in CountryVisibility.GetVisibleCountries(Catalog, HostEnvironment.IsDevelopment()))
                        {
                            <option value="@country.Slug" selected="@string.Equals(country.Slug, CountrySlug, StringComparison.OrdinalIgnoreCase)">@Localizer[CatalogLocalizationKeyResolver.CountryName(country)]</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="category-filter">@Localizer["Search.CategoryFilter"]</label>
                    <select id="category-filter" name="category">
                        <option value="">@Localizer["Search.AllCategories"]</option>
                        @foreach (var category in Catalog.Categories)
                        {
                            <option value="@category.Slug" selected="@string.Equals(category.Slug, CategorySlug, StringComparison.OrdinalIgnoreCase)">@Localizer[CatalogLocalizationKeyResolver.CategoryName(category)]</option>
                        }
                    </select>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit">@Localizer["Search.Submit"]</button>
                <a class="reset-link" href="/search">@Localizer["Search.Reset"]</a>
            </div>
        </form>

        @if (Catalog.InformationEntries.Count == 0)
        {
            <section class="results-state" aria-live="polite">
                <h2>@Localizer["Search.NoContent"]</h2>
            </section>
        }
        else if (Results.Count == 0)
        {
            <section class="results-state" aria-live="polite">
                <h2>@Localizer["Search.NoResults"]</h2>
            </section>
        }
        else
        {
            <section class="results-section" aria-labelledby="results-heading">
                <div class="results-heading">
                    <h2 id="results-heading">@Localizer["Search.ResultsHeading"]</h2>
                    <p>@Localizer["Search.ResultsCount", Results.Count]</p>
                </div>
                <div class="results-list">
                    @foreach (var result in Results)
                    {
                        var countryName = Localizer[CatalogLocalizationKeyResolver.CountryName(result.Country)];
                        var categoryName = Localizer[CatalogLocalizationKeyResolver.CategoryName(result.Category)];
                        <article class="result-card">
                            <h3><a href="/countries/@result.Country.Slug/categories/@result.Category.Slug">@result.Translation.Title</a></h3>
                            <p class="result-summary">@result.Translation.Summary</p>
                            <dl class="result-metadata">
                                <div><dt>@Localizer["Search.ResultCountry"]</dt><dd>@countryName</dd></div>
                                <div><dt>@Localizer["Search.ResultCategory"]</dt><dd>@categoryName</dd></div>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        <HomeLink Placement="bottom" />

        <footer class="information-note">
            <p>@Localizer["Common.Disclaimer"]</p>
        </footer>
    </div>
</main>

@code {
    private IReadOnlyDictionary<string, Microsoft.Extensions.Primitives.StringValues> QueryParameters =>
        QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

    private string? Query => QueryParameters.GetValueOrDefault("q").FirstOrDefault();

    private string? CountrySlug => QueryParameters.GetValueOrDefault("country").FirstOrDefault();

    private string? CategorySlug => QueryParameters.GetValueOrDefault("category").FirstOrDefault();

    private IReadOnlyList<ArticleSearchResult> Results => ArticleSearch.Search(
        Catalog,
        Query,
        CountrySlug,
        CategorySlug,
        VerificationStatus.Verified.ToString(),
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
}
