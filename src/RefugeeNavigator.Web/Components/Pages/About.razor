@page "/about"
@using System.Globalization
@using RefugeeNavigator.Data
@using RefugeeNavigator.Web.Content
@using RefugeeNavigator.Web.Comparison
@using RefugeeNavigator.Web.Localization
@inject CatalogData Catalog
@inject ComparisonFactCatalog ComparisonFacts
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["About.PageTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Localizer["About.MetaDescription"]" />
    <meta property="og:title" content="@Localizer["About.PageTitle"]" />
    <meta property="og:description" content="@Localizer["About.MetaDescription"]" />
</HeadContent>

@{
    var stats = AboutStatisticsProvider.Create(Catalog, ComparisonFacts,
        SupportedCultures.All.Select(culture => culture.TwoLetterISOLanguageName).ToArray());
}

<main id="main-content" class="about-page">
    <div class="about-content">
        <header class="about-header"><h1>@Localizer["About.Heading"]</h1></header>

        <section aria-labelledby="about-mission"><h2 id="about-mission">@Localizer["About.MissionTitle"]</h2><p>@Localizer["About.Mission"]</p></section>
        <section aria-labelledby="about-coverage"><h2 id="about-coverage">@Localizer["About.CoverageTitle"]</h2><p>@Localizer["About.Coverage"]</p></section>

        <section aria-labelledby="about-statistics">
            <h2 id="about-statistics">@Localizer["About.StatisticsTitle"]</h2>
            <dl class="about-statistics">
                <div><dt>@Localizer["About.Countries"]</dt><dd>@stats.Countries.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                <div><dt>@Localizer["About.Articles"]</dt><dd>@stats.PublishedArticles.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                <div><dt>@Localizer["About.Sources"]</dt><dd>@stats.OfficialSources.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                <div><dt>@Localizer["About.Languages"]</dt><dd>@stats.SupportedLanguages.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
            </dl>
        </section>

        <section aria-labelledby="about-research"><h2 id="about-research">@Localizer["About.ResearchTitle"]</h2><p>@Localizer["About.Research"]</p></section>
        <section aria-labelledby="about-maintenance"><h2 id="about-maintenance">@Localizer["About.MaintenanceTitle"]</h2><p>@Localizer["About.Maintenance"]</p></section>
        <section aria-labelledby="about-independence"><h2 id="about-independence">@Localizer["About.IndependenceTitle"]</h2><p>@Localizer["About.Independence"]</p></section>
        <section aria-labelledby="about-disclaimer"><h2 id="about-disclaimer">@Localizer["About.DisclaimerTitle"]</h2><p>@Localizer["About.Disclaimer"]</p></section>
        <section class="about-support" aria-labelledby="about-support-title">
            <h2 id="about-support-title">@Localizer["About.SupportTitle"]</h2>
            <p>@Localizer["About.Support"]</p>
            <p>@Localizer["About.SupportVoluntary"]</p>
            <a class="project-support-link" href="https://ko-fi.com/alexandra_st" target="_blank" rel="noopener noreferrer">@Localizer["About.SupportCta"] <span aria-hidden="true">↗</span></a>
        </section>
    </div>
</main>
