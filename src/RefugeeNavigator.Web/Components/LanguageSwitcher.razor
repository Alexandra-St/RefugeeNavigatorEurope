@using System.Globalization
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<nav class="language-switcher" aria-label="@Localizer["Common.LanguageSelection"]">
    <ul>
        <li><a href="@BuildSwitchUrl("uk")" lang="uk" data-enhance-nav="false" aria-current="@(IsCurrentLanguage("uk") ? "true" : null)">УКР</a></li>
        <li><a href="@BuildSwitchUrl("en")" lang="en" data-enhance-nav="false" aria-current="@(IsCurrentLanguage("en") ? "true" : null)">ENG</a></li>
        <li><a href="@BuildSwitchUrl("ru")" lang="ru" data-enhance-nav="false" aria-current="@(IsCurrentLanguage("ru") ? "true" : null)">РУ</a></li>
    </ul>
</nav>

@code {
    private static string CurrentLanguage => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static bool IsCurrentLanguage(string culture) => CurrentLanguage == culture;

    private string BuildSwitchUrl(string culture)
        => LocalizedUrl.ForLanguageSwitch(new Uri(Navigation.Uri), culture);
}
