@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <script src="/theme.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RefugeeNavigator.Web.styles.css"]" />
    <HeadOutlet />
</head>
<body>
    <a class="skip-link" href="#main-content">@Localizer["Common.SkipToContent"]</a>
    <SiteHeader />
    <Routes />
    <SiteFooter />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        window.syncThemeToggle();
    </script>
    <script>
        const documentCulture = document.documentElement.lang;
        const circuitUrl = new URL("_blazor", document.baseURI);
        circuitUrl.searchParams.set("@CircuitRequestCultureProvider.QueryKey", documentCulture);

        Blazor.start({
            circuit: {
                configureSignalR: builder => builder.withUrl(circuitUrl.href)
            }
        });
        Blazor.addEventListener("enhancedload", () => {
            // A different URL language needs a new document and circuit.
            const routeCulture = window.location.pathname.split("/")[1];
            if (["en", "uk", "ru"].includes(routeCulture) && routeCulture !== documentCulture) {
                window.location.reload();
                return;
            }

            window.applyEffectiveTheme();
            window.syncThemeToggle();
        });
    </script>
</body>
</html>
